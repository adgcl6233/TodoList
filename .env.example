# 📝 待办清单应用 - 环境配置示例
# 复制此文件为 .env 并根据需要修改配置

# ------------------------------
# 后端配置
# ------------------------------

# Flask 服务端口
FLASK_PORT=5000

# Flask 调试模式 (true/false)
FLASK_DEBUG=true

# 数据库文件名
DATABASE_NAME=todos.db

# ------------------------------
# 前端配置
# ------------------------------

# Vite 开发服务器端口
VITE_PORT=3000

# 后端 API 地址 (用于代理配置)
VITE_API_BASE_URL=http://localhost:5000

# ------------------------------
# 注意事项
# ------------------------------
# 1. 不要将 .env 文件提交到 Git 仓库
# 2. .env.example 文件作为模板，可以提交到仓库
# 3. 修改配置后需要重启服务才能生效
